---
// Binary entropy function H(p) = -p log2(p) - (1 - p) log2(1 - p), drawn as an
// inline SVG at build time with no chart library. Colours come from the theme
// variables in global.css, so it follows the light/dark toggle. A small script
// adds a hover / touch / keyboard readout of H(p); without JS the static plot
// still renders. Pass a caption as the default slot.

const W = 480;
const H = 300;
const m = { top: 36, right: 20, bottom: 50, left: 64 };
const pw = W - m.left - m.right;
const ph = H - m.top - m.bottom;

const x = (p: number) => m.left + p * pw;
const y = (h: number) => m.top + (1 - h) * ph;

const entropy = (p: number) =>
  p <= 0 || p >= 1 ? 0 : -p * Math.log2(p) - (1 - p) * Math.log2(1 - p);

// Cosine spacing puts more samples near p = 0 and 1, where the curve is steepest.
const N = 200;
const points = Array.from({ length: N + 1 }, (_, i) => {
  const p = (1 - Math.cos((Math.PI * i) / N)) / 2;
  return `${x(p).toFixed(2)},${y(entropy(p)).toFixed(2)}`;
});
const curve = `M${points.join("L")}`;
const area = `${curve}L${x(0)},${y(0)}Z`;

const ticks = [0, 0.25, 0.5, 0.75, 1];
const hasCaption = Astro.slots.has("default");
const descId = `bef-desc-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class="bef">
  <svg
    class="bef-plot"
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label="Binary entropy function"
    aria-describedby={descId}
    data-left={m.left}
    data-top={m.top}
    data-width={pw}
    data-height={ph}
  >
    <desc id={descId}>
      A symmetric arch: H(p) is 0 at p = 0 and p = 1, and peaks at 1 shannon
      when p = 0.5.
    </desc>

    {
      ticks.map((t) => (
        <g>
          <line class="grid" x1={x(0)} x2={x(1)} y1={y(t)} y2={y(t)} />
          <text
            class="tick"
            x={m.left - 10}
            y={y(t)}
            text-anchor="end"
            dominant-baseline="middle"
          >
            {t}
          </text>
          <text class="tick" x={x(t)} y={y(0) + 20} text-anchor="middle">
            {t}
          </text>
        </g>
      ))
    }

    <path class="area" d={area}></path>
    <line class="guide" x1={x(0.5)} x2={x(0.5)} y1={y(1)} y2={y(0)}></line>
    <path class="curve" d={curve}></path>
    <line class="axis" x1={x(0)} x2={x(1)} y1={y(0)} y2={y(0)}></line>

    <circle class="peak" cx={x(0.5)} cy={y(1)} r="5"></circle>
    <text class="note" x={x(0.5)} y={y(1) - 14} text-anchor="middle">
      <tspan font-style="italic">H</tspan>(½) = 1
    </text>

    <text class="label" x={x(0.5)} y={H - 6} text-anchor="middle">
      <tspan font-style="italic">p</tspan> (probability of “yes”)
    </text>
    <text
      class="label"
      transform={`translate(16 ${y(0.5)}) rotate(-90)`}
      text-anchor="middle"
    >
      <tspan font-style="italic">H</tspan>(<tspan font-style="italic">p</tspan>)
      in shannons
    </text>

    <!-- Hover readout, positioned by the script below. -->
    <g class="hover" aria-hidden="true">
      <line class="hover-line hover-x"></line>
      <line class="hover-line hover-y"></line>
      <circle class="hover-dot" r="5"></circle>
      <g class="hover-tip">
        <rect class="hover-tip-bg" rx="6"></rect>
        <text class="hover-tip-text" dominant-baseline="central"></text>
      </g>
    </g>
  </svg>
  {
    hasCaption && (
      <figcaption>
        <slot />
      </figcaption>
    )
  }
</figure>

<script>
  const SVG_NS = "http://www.w3.org/2000/svg";

  const entropy = (p: number) =>
    p <= 0 || p >= 1 ? 0 : -p * Math.log2(p) - (1 - p) * Math.log2(1 - p);

  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));

  function tspan(text: string, italic = false): SVGTSpanElement {
    const el = document.createElementNS(SVG_NS, "tspan");
    el.textContent = text;
    if (italic) el.setAttribute("font-style", "italic");
    return el;
  }

  function initPlot(svg: SVGSVGElement) {
    if (svg.dataset.ready) return;

    const figure = svg.closest("figure");
    const lineX = svg.querySelector<SVGLineElement>(".hover-x");
    const lineY = svg.querySelector<SVGLineElement>(".hover-y");
    const dot = svg.querySelector<SVGCircleElement>(".hover-dot");
    const tip = svg.querySelector<SVGGElement>(".hover-tip");
    const tipBg = svg.querySelector<SVGRectElement>(".hover-tip-bg");
    const tipText = svg.querySelector<SVGTextElement>(".hover-tip-text");
    if (!figure || !lineX || !lineY || !dot || !tip || !tipBg || !tipText) {
      return;
    }
    svg.dataset.ready = "true";

    const left = Number(svg.dataset.left);
    const top = Number(svg.dataset.top);
    const width = Number(svg.dataset.width);
    const height = Number(svg.dataset.height);
    const x = (p: number) => left + p * width;
    const y = (h: number) => top + (1 - h) * height;

    const pValue = tspan("");
    const hName = tspan("H", true);
    const hValue = tspan("");
    hName.setAttribute("dx", "12");
    tipText.append(tspan("p", true), pValue, hName, hValue);

    const padX = 8;
    const padY = 5;
    let current = 0.5;

    const show = (p: number) => {
      // Snap to 0.01 so the readout and the keyboard steps agree.
      current = Math.round(clamp01(p) * 100) / 100;
      const h = entropy(current);
      const px = x(current);
      const py = y(h);

      lineX.setAttribute("x1", String(px));
      lineX.setAttribute("x2", String(px));
      lineX.setAttribute("y1", String(py));
      lineX.setAttribute("y2", String(y(0)));
      lineY.setAttribute("x1", String(x(0)));
      lineY.setAttribute("x2", String(px));
      lineY.setAttribute("y1", String(py));
      lineY.setAttribute("y2", String(py));
      dot.setAttribute("cx", String(px));
      dot.setAttribute("cy", String(py));

      pValue.textContent = ` = ${current.toFixed(2)}`;
      hValue.textContent = ` = ${h.toFixed(3)}`;

      // Size the tooltip to its text, then keep it inside the plot area.
      figure.classList.add("active");
      const box = tipText.getBBox();
      const tw = box.width + padX * 2;
      const th = box.height + padY * 2;
      let tx = px + 12;
      if (tx + tw > left + width) tx = px - 12 - tw;
      const ty = Math.max(2, py - 12 - th);
      tip.setAttribute("transform", `translate(${tx} ${ty})`);
      tipBg.setAttribute("width", String(tw));
      tipBg.setAttribute("height", String(th));
      tipText.setAttribute("x", String(padX));
      tipText.setAttribute("y", String(th / 2));

      svg.setAttribute("aria-valuenow", current.toFixed(2));
      svg.setAttribute(
        "aria-valuetext",
        `p = ${current.toFixed(2)}, H(p) = ${h.toFixed(3)} shannons`,
      );
    };

    const hide = () => figure.classList.remove("active");

    const fromPointer = (e: PointerEvent) => {
      const ctm = svg.getScreenCTM();
      if (!ctm) return;
      const pt = new DOMPoint(e.clientX, e.clientY).matrixTransform(
        ctm.inverse(),
      );
      show((pt.x - left) / width);
    };

    svg.addEventListener("pointermove", fromPointer);
    svg.addEventListener("pointerdown", fromPointer);
    // On touch, leave the last tapped value showing rather than flashing it away.
    svg.addEventListener("pointerleave", (e) => {
      if (e.pointerType !== "touch") hide();
    });

    // Keyboard: the plot becomes a slider over p.
    svg.setAttribute("role", "slider");
    svg.setAttribute("tabindex", "0");
    svg.setAttribute(
      "aria-label",
      "Binary entropy function. Use the arrow keys to change p.",
    );
    svg.setAttribute("aria-valuemin", "0");
    svg.setAttribute("aria-valuemax", "1");
    svg.setAttribute("aria-valuenow", "0.50");

    svg.addEventListener("focus", () => show(current));
    svg.addEventListener("blur", hide);
    svg.addEventListener("keydown", (e) => {
      const step = e.shiftKey ? 0.1 : 0.01;
      let next: number;
      switch (e.key) {
        case "ArrowLeft":
        case "ArrowDown":
          next = current - step;
          break;
        case "ArrowRight":
        case "ArrowUp":
          next = current + step;
          break;
        case "Home":
          next = 0;
          break;
        case "End":
          next = 1;
          break;
        case "Escape":
          hide();
          return;
        default:
          return;
      }
      e.preventDefault();
      show(next);
    });
  }

  const initAll = () => {
    for (const svg of document.querySelectorAll<SVGSVGElement>(
      "svg.bef-plot",
    )) {
      initPlot(svg);
    }
  };

  // Run now for the first load, and again after each ClientRouter navigation.
  document.addEventListener("astro:page-load", initAll);
  initAll();
</script>

<style>
  .bef svg {
    display: block;
    width: 100%;
    max-width: 540px;
    height: auto;
    margin: 0 auto;
    cursor: crosshair;
    touch-action: pan-y;
    border-radius: 8px;
  }
  .bef svg:focus {
    outline: none;
  }
  .bef svg:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .grid {
    stroke: var(--line);
    stroke-width: 1;
  }
  .axis {
    stroke: var(--mut);
    stroke-width: 1;
  }
  .guide {
    stroke: var(--dim);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }
  .area {
    fill: var(--accent);
    fill-opacity: 0.1;
  }
  .curve {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .peak {
    fill: var(--accent);
    stroke: var(--bg);
    stroke-width: 2;
  }
  .tick {
    font-family: var(--mono);
    font-size: 12px;
    fill: var(--dim);
  }
  .label {
    font-family: var(--sans);
    font-size: 13px;
    fill: var(--mut);
  }
  .note {
    font-family: var(--sans);
    font-size: 12.5px;
    fill: var(--reading);
    transition: opacity 120ms ease;
  }

  .hover {
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms ease;
  }
  .bef.active .hover {
    opacity: 1;
  }
  /* The readout would collide with the peak label, so swap one for the other. */
  .bef.active .note {
    opacity: 0;
  }
  .hover-line {
    stroke: var(--mut);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  .hover-dot {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 2.5;
  }
  .hover-tip-bg {
    fill: var(--card);
    stroke: var(--line);
  }
  .hover-tip-text {
    font-family: var(--mono);
    font-size: 12px;
    fill: var(--ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .hover,
    .note {
      transition: none;
    }
  }
</style>
